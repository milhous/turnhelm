  "cards": [
    {
      "dot": "cyan",
      "title": "Routing budget",
      "items": [
        "Default routing budget 10000 ms (routingTimeoutMs)",
        "Dual-backend: Laya gets floor(remaining × ¾) — 7500 ms at defaults, reserving a quarter for Jev",
        "Sole backend receives the full remaining budget",
        "Attempts are sequential; the first valid typed choice ends routing"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and isolation",
      "items": [
        "Hosted Jev requires all three gates: config enabled, TURNHELM_ALLOW_HOSTED_JEV=1, non-empty TYPESAFE_API_KEY",
        "Worker child env strips routing credentials; TURNHELM_MANAGED_CHILD=1 blocks recursion",
        "Sandbox read-only unless --write; at most one worker per run"
      ]
    },
    {
      "dot": "emerald",
      "title": "Task entry and evidence",
      "items": [
        "Task limited to 8192 UTF-8 bytes via argv or stdin; continuation-only prompts rejected",
        "Exactly one turnhelm.receipt on stderr once classification starts",
        "routes.jsonl journals the task SHA-256 and decision, never task text"
      ]
    }
  ]
