{
  "name": "turnhelm",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "type": "module",
  "files": [
    "dist/src",
    "assets/config.json",
    ".agents/skills/turnhelm-routing"
  ],
  "bin": {
    "turnhelm": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage --test-coverage-include='dist/src/**' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 dist/test/*.test.js",
    "test:live": "pnpm run build && node --test dist/test/live.integration.js"
  },
  "engines": {
    "node": ">=22.8.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
